generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String
  password      String
  role          AdminRole      @default(OPERATOR) // ← agregar
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)
  contracts     Contract[]
  refreshTokens RefreshToken[]

  contractAuditEvents ContractAuditEvent[]

  contractDocuments ContractDocument[] @relation("ReviewedContractDocuments")

  uploadedContractDocuments ContractDocument[] @relation("UploadedContractDocuments")
}

enum AdminRole {
  ADMIN
  OPERATOR
  CREDIT_ANALYST
}

enum DataReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Contract {
  id             String           @id @default(uuid())
  title          String
  contractNumber String?          @unique
  contractType   String?
  status         ContractStatus   @default(DRAFT)
  templateKey    String           @default("dimcultura")
  consecutivo    String
  sequence       Int

  startDate DateTime? @db.Timestamptz(3)
  endDate   DateTime? @db.Timestamptz(3)
  subject   String?   @db.Text

  amount        Int
  currency      String?  @default("COP")
  paymentMethod String?

  originalUrl String?
  signedUrl   String?

  token          String?   @unique
  tokenExpiresAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  adminId String
  admin   Admin  @relation(fields: [adminId], references: [id], onDelete: Cascade)

  libranzaData        LibranzaData?
  parties             ContractParty[]
  clauses             ContractClause[]
  signers             ContractSigner[]
  signatures          Signature[]
  documents           ContractDocument[]
  contractAuditEvents ContractAuditEvent[]

  isSigned         Boolean          @default(false)
  dataReviewStatus DataReviewStatus @default(PENDING)
  dataReviewNotes  String?
  pagares Pagare?

  identityVerification IdentityVerification?
  @@unique([templateKey, sequence])
  @@index([adminId])
  @@index([status])
  @@index([dataReviewStatus])
}

enum ContractStatus {
  DRAFT // creado, editable por asesor
  PENDING_DOCUMENTS // falta subir documentos
  DOCUMENTS_UPLOADED // documentos completos
  PENDING_VERIFICATION // validación (opcional: manual o automática)
  READY_TO_SIGN // listo para firma
  SENT // link enviado al cliente
  VIEWED // cliente abrió link
  OTP_PENDING // esperando verificación OTP
  OTP_VERIFIED // OTP validado
  PARTIALLY_SIGNED // firma parcial
  SIGNED // contrato firmado
  REJECTED // rechazado (docs inválidos o cliente)
  EXPIRED // expirado
  CANCELLED // cancelado manualmente
}

// ─────────────────────────────────────────────────────────
// LIBRANZA — datos específicos del documento
// Relación 1-a-1 con Contract
// ─────────────────────────────────────────────────────────
model LibranzaData {
  id         String   @id @default(uuid())
  contractId String   @unique
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  // Encabezado
  ciudad String?
  asesor String?
  fecha  String? // "DD/MM/AAAA"

  // Datos personales
  clienteNombre      String?
  clienteCC          String?
  clienteCCDe        String?
  clienteDireccion   String?
  clienteTelefono    String?
  clienteEmail       String?
  clienteFuncionario String?
  clienteDesdeHace   String?

  // NUEVO
  clienteFechaNacimiento   DateTime? @db.Date
  clienteFechaExpedicionCC DateTime? @db.Date

  // Datos laborales
  municipioTrabajo String?
  empresaTrabajo   String?
  departamento     String?

  // NUEVO - pagaduría
  pagaduriaNombre       String?
  pagaduriaMunicipio    String?
  pagaduriaDepartamento String?
  tipoContrato          ContractEmploymentType?

  // Financiero
  sumaTotal    Int
  numeroCuotas Int
  valorCuota   Int
  mesCobro     String?

  // Cuenta bancaria
  tipoCuenta   String?
  numeroCuenta String?
  banco        String?

  productos Json?

  formaPago String?

  createdAt  DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @db.Timestamptz(3)
  references Reference[]
  pagares Pagare?

  @@index([contractId])
  @@index([pagaduriaNombre])
  @@index([tipoContrato])
}

enum ContractEmploymentType {
  PROVISIONAL
  TEMPORAL
  PROVISIONAL_VACANTE_DEFINITIVA
  CARRERA_ADMINISTRATIVA
  PENSIONADO
}

// ─────────────────────────────────────────────────────────
// Los modelos de abajo NO cambian — igual que antes
// ─────────────────────────────────────────────────────────

model ContractParty {
  id         String   @id @default(uuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  role           PartyRole
  name           String
  identification String?
  email          String?
  phone          String?
  address        String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([contractId])
  @@index([role])
}

model ContractClause {
  id         String   @id @default(uuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  position Int
  content  String @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([contractId])
}

model ContractSigner {
  id         String   @id @default(uuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  partyRole   PartyRole?
  name        String
  email       String?
  phone       String?
  roleTitle   String?
  signerOrder Int        @default(1)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  signatures          Signature[]
  contractAuditEvents ContractAuditEvent[]

  @@index([contractId])
}

model Signature {
  id         String   @id @default(uuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  signerId String?
  signer   ContractSigner? @relation(fields: [signerId], references: [id], onDelete: SetNull)

  type       SignatureType
  imageUrl   String?
  typedValue String?
  signedAt   DateTime      @default(now()) @db.Timestamptz(3)
  ipAddress  String?
  userAgent  String?

  // ── Validez legal ─────────────────────────────────────
  documentHash String?
  signerEmail  String?
  otpVerified  Boolean @default(false)

  // ── Storage de firma dibujada ────────────────────────
  signaturePublicId String?
  mimeType          String?

  @@index([contractId])
  @@index([signerId])
}

enum SignatureType {
  DRAWN
  TYPED
  CLICK_TO_SIGN
}

enum PartyRole {
  ACREEDOR
  DEUDOR
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

// ─────────────────────────────────────────────────────────
// DOCUMENTOS ADJUNTOS — subidos por el cliente al firmar
// ─────────────────────────────────────────────────────────
model ContractDocument {
  id         String               @id @default(uuid())
  contractId String
  type       ContractDocumentType

  status DocumentStatus @default(PENDING)
  notes  String?

  fileUrl  String?
  fileName String?
  mimeType String?
  source   DocumentSource?

  publicId     String?
  resourceType String?
  format       String?
  bytes        Int?

  reviewedById String?
  reviewedAt   DateTime?

  uploadedById String?
  uploadedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  reviewedBy Admin?   @relation("ReviewedContractDocuments", fields: [reviewedById], references: [id])
  uploadedBy Admin?   @relation("UploadedContractDocuments", fields: [uploadedById], references: [id])

  @@unique([contractId, type])
  @@index([contractId])
  @@index([type])
  @@index([status])
}

enum ContractDocumentType {
  ID_FRONT
  ID_BACK
  SELFIE_WITH_ID
  BANK_CERTIFICATE
  PAYROLL_STUB
  ADDITIONAL_DOCUMENT
}

enum DocumentSource {
  CAMERA
  FILE_UPLOAD
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

model ContractAuditEvent {
  id         String  @id @default(uuid())
  contractId String
  signerId   String?
  adminId    String?

  eventType AuditEventType
  actorType AuditActorType
  actorRole AdminRole?

  actorName  String?
  actorEmail String?

  ipAddress String?
  userAgent String?
  sessionId String?
  requestId String?

  documentHash String?

  previousEventHash String?
  eventHash         String

  metadata Json?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  contract Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  signer   ContractSigner? @relation(fields: [signerId], references: [id], onDelete: SetNull)
  admin    Admin?          @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([contractId, createdAt])
  @@index([contractId, id])
  @@index([eventType])
  @@index([signerId])
  @@index([adminId])
}

enum AuditEventType {
  CONTRACT_CREATED
  CONTRACT_UPDATED
  CONTRACT_SENT

  EMAIL_SEND_REQUESTED
  EMAIL_SENT
  EMAIL_FAILED

  LINK_OPENED
  OTP_SENT
  OTP_VERIFIED

  SIGNATURE_STARTED
  SIGNATURE_COMPLETED

  ID_FRONT_UPLOADED
  ID_BACK_UPLOADED
  SELFIE_WITH_ID_UPLOADED
  BANK_CERTIFICATE_UPLOADED
  PAYROLL_STUB_UPLOADED
  ADDITIONAL_DOCUMENT_UPLOADED

  CONTRACT_SIGNED
  CONTRACT_DOWNLOADED

  CONTRACT_CANCELLED
  CONTRACT_EXPIRED
  HASH_SEALED
}

enum AuditActorType {
  ADMIN
  OPERATOR
  CREDIT_ANALYST
  SIGNER
  SYSTEM
}

model Reference {
  id         String       @id @default(uuid())
  libranzaId String
  libranza   LibranzaData @relation(fields: [libranzaId], references: [id], onDelete: Cascade)

  type         ReferenceType
  name         String
  phone        String?
  email        String?
  company      String?
  position     String?
  relationShip String?
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)

  @@index([libranzaId])
}

enum ReferenceType {
  PERSONAL
  LABORAL
}

enum PublicContractIdentifierType {
  EMAIL
  PHONE
}

model PublicContractSession {
  id String @id @default(uuid())

  identifier     String
  identifierType PublicContractIdentifierType

  email String?
  phone String?

  otpCode      String?
  otpExpiresAt DateTime?
  otpAttempts  Int       @default(0)

  sessionToken String?   @unique
  expiresAt    DateTime?
  verifiedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([identifier])
  @@index([identifier])
  @@index([identifierType])
  @@index([email])
  @@index([phone])
  @@index([sessionToken])
}

enum PagareStatus {
  DRAFT
  SIGNED
  CANCELLED
}

enum PagareSignatureType {
  TYPED
  DRAWN
}

model Pagare {
  id     String @id @default(uuid())
  number Int    @unique @default(autoincrement())

  contractId     String @unique
  libranzaDataId String @unique
  libranzaToken  String @unique

  status PagareStatus @default(DRAFT)

  ciudadFirma       String?
  fechaSuscripcion  DateTime?
  fechaPrimeraCuota String?
  ciudadPago        String?

  acreedorNombre    String @default("GRUCULCOL")
  acreedorNit       String
  deudorNombre      String
  deudorDocumento   String
  deudorDocumentoDe String
  deudorDireccion   String
  deudorTelefono    String
  deudorEmail       String

  valorTotal       Int
  numeroCuotas     Int
  valorCuota       Int
  isSigned         Boolean @default(false)
  interesCorriente String?
  interesMora      String?

  signedAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contract     Contract     @relation(fields: [contractId], references: [id], onDelete: Cascade)
  libranzaData LibranzaData @relation(fields: [libranzaDataId], references: [id], onDelete: Cascade)
  signature    PagareSignature?

  @@index([number])
  @@map("pagares")
  identityVerifications IdentityVerification[]
}

model PagareSignature {
  id                String              @id @default(cuid())
  pagareId          String              @unique
  type              PagareSignatureType
  typedValue        String?
  imageUrl          String?
  signaturePublicId String?
  signedAt          DateTime            @default(now())
  ipAddress         String?
  userAgent         String?
  documentHash      String?

  pagare Pagare @relation(fields: [pagareId], references: [id], onDelete: Cascade)
}


// ─────────────────────────────────────────────────────────

enum IdentityVerificationStatus {
  PENDING_PROVIDER
  STARTED
  SUBMITTED
  PROCESSING
  APPROVED
  REJECTED
  MANUAL_REVIEW
  EXPIRED
  ABANDONED
  ERROR
}

enum IdentityVerificationProvider {
  VERIFF
}

model IdentityVerification {
  id String @id @default(uuid())

  contractId String @unique
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  pagareId String? @unique
  pagare   Pagare? @relation(fields: [pagareId], references: [id], onDelete: SetNull)

  status   IdentityVerificationStatus @default(PENDING_PROVIDER)
  provider IdentityVerificationProvider @default(VERIFF)

  providerRequestId String?
  providerStatus    String?
  providerReference String?
  sessionUrl        String?

  endUserId   String?
  vendorData  String?

  documentNumber String?
  fullName       String?

  notes           String?
  rejectionReason String?

  submittedAt DateTime? @db.Timestamptz(3)
  processedAt DateTime? @db.Timestamptz(3)
  approvedAt  DateTime? @db.Timestamptz(3)
  rejectedAt  DateTime? @db.Timestamptz(3)

  rawResponse Json?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([status])
}