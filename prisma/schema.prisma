generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String
  password      String
  role          AdminRole      @default(OPERATOR) // ← agregar
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)
  contracts     Contract[]
  refreshTokens RefreshToken[]

  contractAuditEvents ContractAuditEvent[]
}

enum AdminRole {
  ADMIN
  OPERATOR
}

model Contract {
  id             String         @id @default(uuid())
  title          String
  contractNumber String?        @unique
  contractType   String?
  status         ContractStatus @default(DRAFT)

  templateKey String    @default("dimcultura")
  
  startDate   DateTime? @db.Timestamptz(3)
  endDate     DateTime? @db.Timestamptz(3)
  subject     String?   @db.Text

  amount        Decimal? @db.Decimal(12, 2)
  currency      String?  @default("COP")
  paymentMethod String?

  originalUrl String?
  signedUrl   String?

  token          String?   @unique
  tokenExpiresAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  adminId String
  admin   Admin  @relation(fields: [adminId], references: [id], onDelete: Cascade)

  // ── Relaciones ──────────────────────────────────────────
  libranzaData        LibranzaData? // ← NUEVO: datos específicos de la libranza
  parties             ContractParty[]
  clauses             ContractClause[]
  signers             ContractSigner[]
  fields              SignatureField[]
  signatures          Signature[]
  documents           ContractDocument[]
  contractAuditEvents ContractAuditEvent[]

  @@index([adminId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────
// LIBRANZA — datos específicos del documento
// Relación 1-a-1 con Contract
// ─────────────────────────────────────────────────────────
model LibranzaData {
  id         String   @id @default(uuid())
  contractId String   @unique
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  // Encabezado
  ciudad String?
  asesor String?
  fecha  String? // "DD/MM/AAAA"

  // Datos personales
  clienteNombre      String?
  clienteCC          String?
  clienteCCDe        String?
  clienteDireccion   String?
  clienteTelefono    String?
  clienteEmail       String?
  clienteFuncionario String?
  clienteDesdeHace   String?

  // Datos laborales
  municipioTrabajo String?
  empresaTrabajo   String?
  departamento     String?

  // Financiero
  sumaTotal    String?
  numeroCuotas String?
  valorCuota   String?
  mesCobro     String?

  // Cuenta bancaria
  tipoCuenta   String? // "Ahorros" | "Corriente"
  numeroCuenta String?
  banco        String?

  // Productos [{codigo, descripcion, valor}]
  productos Json?

  // Forma de pago
  formaPago String? // "NOMINA" | "EFECTY 110520" | "PSE" | "BANCO"

  createdAt  DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @db.Timestamptz(3)
  references Reference[]

  @@index([contractId])
}

// ─────────────────────────────────────────────────────────
// Los modelos de abajo NO cambian — igual que antes
// ─────────────────────────────────────────────────────────

model ContractParty {
  id         String   @id @default(uuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  role           PartyRole
  name           String
  identification String?
  email          String?
  phone          String?
  address        String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([contractId])
  @@index([role])
}

model ContractClause {
  id         String   @id @default(uuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  position Int
  content  String @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([contractId])
}

model ContractSigner {
  id         String   @id @default(uuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  partyRole   PartyRole?
  name        String
  email       String?
  phone       String?
  roleTitle   String?
  signerOrder Int        @default(1)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  signatures          Signature[]
  signatureFields     SignatureField[]
  contractAuditEvents ContractAuditEvent[]

  @@index([contractId])
}

model SignatureField {
  id         String   @id @default(uuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  signerId String?
  signer   ContractSigner? @relation(fields: [signerId], references: [id], onDelete: SetNull)

  page  Int
  xPct  Float
  yPct  Float
  wPct  Float
  hPct  Float
  label String @default("Firma")

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  signatures Signature[]

  @@index([contractId])
  @@index([signerId])
}

model Signature {
  id         String   @id @default(uuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  signerId String?
  signer   ContractSigner? @relation(fields: [signerId], references: [id], onDelete: SetNull)

  fieldId String?
  field   SignatureField? @relation(fields: [fieldId], references: [id], onDelete: SetNull)

  type       SignatureType
  imageUrl   String?
  typedValue String?
  signedAt   DateTime      @default(now()) @db.Timestamptz(3)
  ipAddress  String?
  userAgent  String?

  // ── Validez legal ─────────────────────────────────────
  documentHash String?
  signerEmail  String?
  otpVerified  Boolean @default(false)

  // ── Storage de firma dibujada ────────────────────────
  signaturePublicId String?
  mimeType          String?

  @@index([contractId])
  @@index([signerId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

enum ContractStatus {
  DRAFT
  SENT
  VIEWED
  PARTIALLY_SIGNED
  SIGNED
  EXPIRED
  CANCELLED
}

enum SignatureType {
  DRAWN
  TYPED
  CLICK_TO_SIGN
}

enum PartyRole {
  CONTRACTOR
  CONTRACTED
}

// ─────────────────────────────────────────────────────────
// DOCUMENTOS ADJUNTOS — subidos por el cliente al firmar
// ─────────────────────────────────────────────────────────
model ContractDocument {
  id         String   @id @default(uuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  type      DocumentType
  label     String // "Cédula frente", "Cédula reverso", "Selfie", "Otro"
  url       String // URL de Cloudinary
  publicId  String? // Cloudinary public_id para borrar si hace falta
  mimeType  String? // "image/jpeg", "application/pdf", etc.
  sizeBytes Int?

  uploadedAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([contractId])
}

enum DocumentType {
  CEDULA_FRENTE
  CEDULA_REVERSO
  SELFIE
  PDF_ADICIONAL
  IMAGEN_GENERAL
}

model ContractAuditEvent {
  id         String  @id @default(uuid())
  contractId String
  signerId   String?
  adminId    String?

  eventType AuditEventType
  actorType AuditActorType
  actorRole AdminRole?

  actorName  String?
  actorEmail String?

  ipAddress String?
  userAgent String?
  sessionId String?
  requestId String?

  documentHash String?

  previousEventHash String?
  eventHash         String

  metadata Json?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  contract Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  signer   ContractSigner? @relation(fields: [signerId], references: [id], onDelete: SetNull)
  admin    Admin?          @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([contractId, createdAt])
  @@index([contractId, id])
  @@index([eventType])
  @@index([signerId])
  @@index([adminId])
}

enum AuditEventType {
  CONTRACT_CREATED
  CONTRACT_UPDATED
  CONTRACT_SENT

  EMAIL_SEND_REQUESTED
  EMAIL_SENT
  EMAIL_FAILED

  LINK_OPENED
  OTP_SENT
  OTP_VERIFIED

  SIGNATURE_STARTED
  SIGNATURE_COMPLETED

  DOCUMENT_UPLOADED
  ID_FRONT_UPLOADED
  ID_BACK_UPLOADED
  SELFIE_UPLOADED

  CONTRACT_SIGNED
  CONTRACT_DOWNLOADED

  CONTRACT_CANCELLED
  CONTRACT_EXPIRED
  HASH_SEALED
}

enum AuditActorType {
  ADMIN
  SIGNER
  SYSTEM
}

model Reference {
  id         String       @id @default(uuid())
  libranzaId String
  libranza   LibranzaData @relation(fields: [libranzaId], references: [id], onDelete: Cascade)

  type     ReferenceType
  name     String
  phone    String?
  email    String?
  company  String?
  position String?
  relationShip String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([libranzaId])
}

enum ReferenceType {
  PERSONAL
  LABORAL
}
