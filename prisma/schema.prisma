generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String
  password      String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  contracts     Contract[]
  refreshTokens RefreshToken[]
}

model Contract {
  id             String         @id @default(uuid())
  title          String
  contractNumber String?        @unique
  contractType   String?
  status         ContractStatus @default(DRAFT)

  startDate      DateTime?
  endDate        DateTime?
  subject        String?        @db.Text

  amount         Decimal?       @db.Decimal(12, 2)
  currency       String?        @default("COP")
  paymentMethod  String?

  originalUrl    String?
  signedUrl      String?

  token          String?        @unique
  tokenExpiresAt DateTime?

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  adminId        String
  admin          Admin          @relation(fields: [adminId], references: [id], onDelete: Cascade)

  // ── Relaciones ──────────────────────────────────────────
  libranzaData   LibranzaData?   // ← NUEVO: datos específicos de la libranza
  parties        ContractParty[]
  clauses        ContractClause[]
  signers        ContractSigner[]
  fields         SignatureField[]
  signatures     Signature[]
  documents      ContractDocument[]

  @@index([adminId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────
// LIBRANZA — datos específicos del documento
// Relación 1-a-1 con Contract
// ─────────────────────────────────────────────────────────
model LibranzaData {
  id         String   @id @default(uuid())
  contractId String   @unique
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  // Encabezado
  ciudad     String?
  asesor     String?
  fecha      String?   // "DD/MM/AAAA"

  // Datos personales
  clienteNombre       String?
  clienteCC           String?
  clienteCCDe         String?
  clienteDireccion    String?
  clienteTelefono     String?
  clienteEmail        String?
  clienteFuncionario  String?
  clienteDesdeHace    String?

  // Datos laborales
  municipioTrabajo    String?
  empresaTrabajo      String?
  departamento        String?

  // Financiero
  sumaTotal           String?
  numeroCuotas        String?
  valorCuota          String?
  mesCobro            String?

  // Cuenta bancaria
  tipoCuenta          String?   // "Ahorros" | "Corriente"
  numeroCuenta        String?
  banco               String?

  // Productos [{codigo, descripcion, valor}]
  productos           Json?

  // Forma de pago
  formaPago           String?   // "NOMINA" | "EFECTY 110520" | "PSE" | "BANCO"

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([contractId])
}

// ─────────────────────────────────────────────────────────
// Los modelos de abajo NO cambian — igual que antes
// ─────────────────────────────────────────────────────────

model ContractParty {
  id             String    @id @default(uuid())
  contractId     String
  contract       Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)

  role           PartyRole
  name           String
  identification String?
  email          String?
  phone          String?
  address        String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([contractId])
  @@index([role])
}

model ContractClause {
  id         String   @id @default(uuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  position   Int
  content    String   @db.Text

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([contractId])
}

model ContractSigner {
  id          String    @id @default(uuid())
  contractId  String
  contract    Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)

  partyRole   PartyRole?
  name        String
  email       String?
  phone       String?
  roleTitle   String?
  signerOrder Int       @default(1)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  signatures      Signature[]
  signatureFields SignatureField[]

  @@index([contractId])
}

model SignatureField {
  id         String          @id @default(uuid())
  contractId String
  contract   Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)

  signerId   String?
  signer     ContractSigner? @relation(fields: [signerId], references: [id], onDelete: SetNull)

  page       Int
  xPct       Float
  yPct       Float
  wPct       Float
  hPct       Float
  label      String          @default("Firma")

  createdAt  DateTime        @default(now())

  signatures Signature[]

  @@index([contractId])
  @@index([signerId])
}

model Signature {
  id         String          @id @default(uuid())
  contractId String
  contract   Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)

  signerId   String?
  signer     ContractSigner? @relation(fields: [signerId], references: [id], onDelete: SetNull)

  fieldId    String?
  field      SignatureField? @relation(fields: [fieldId], references: [id], onDelete: SetNull)

  type       SignatureType
  imageUrl   String?
  typedValue String?
  signedAt   DateTime        @default(now())
  ipAddress  String?
  userAgent  String?

  // ── Validez legal ─────────────────────────────────────
  documentHash      String?
  signerEmail       String?
  otpVerified       Boolean   @default(false)

  // ── Storage de firma dibujada ────────────────────────
  signaturePublicId String?
  mimeType          String?

  @@index([contractId])
  @@index([signerId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

enum ContractStatus {
  DRAFT
  SENT
  VIEWED
  PARTIALLY_SIGNED
  SIGNED
  EXPIRED
  CANCELLED
}

enum SignatureType {
  DRAWN
  TYPED
  CLICK_TO_SIGN
}

enum PartyRole {
  CONTRACTOR
  CONTRACTED
}

// ─────────────────────────────────────────────────────────
// DOCUMENTOS ADJUNTOS — subidos por el cliente al firmar
// ─────────────────────────────────────────────────────────
model ContractDocument {
  id          String   @id @default(uuid())
  contractId  String
  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  type        DocumentType
  label       String        // "Cédula frente", "Cédula reverso", "Selfie", "Otro"
  url         String        // URL de Cloudinary
  publicId    String?       // Cloudinary public_id para borrar si hace falta
  mimeType    String?       // "image/jpeg", "application/pdf", etc.
  sizeBytes   Int?

  uploadedAt  DateTime @default(now())

  @@index([contractId])
}

enum DocumentType {
  CEDULA_FRENTE
  CEDULA_REVERSO
  SELFIE
  PDF_ADICIONAL
  IMAGEN_GENERAL
}
