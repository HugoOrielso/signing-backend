generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String
  password      String
  role          AdminRole      @default(OPERATOR) // ← agregar
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)
  contracts     Contract[]
  refreshTokens RefreshToken[]

  contractAuditEvents ContractAuditEvent[]

  contractDocuments ContractDocument[] @relation("ReviewedContractDocuments")

  uploadedContractDocuments ContractDocument[] @relation("UploadedContractDocuments")
}

enum AdminRole {
  ADMIN
  OPERATOR
  CREDIT_ANALYST
}

model Contract {
  id             String         @id @default(uuid())
  title          String
  contractNumber String?        @unique
  contractType   String?
  status         ContractStatus @default(DRAFT)

  templateKey String @default("dimcultura")

  startDate DateTime? @db.Timestamptz(3)
  endDate   DateTime? @db.Timestamptz(3)
  subject   String?   @db.Text

  amount        Decimal? @db.Decimal(12, 2)
  currency      String?  @default("COP")
  paymentMethod String?

  originalUrl String?
  signedUrl   String?

  token          String?   @unique
  tokenExpiresAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  adminId String
  admin   Admin  @relation(fields: [adminId], references: [id], onDelete: Cascade)

  // ── Relaciones ──────────────────────────────────────────
  libranzaData        LibranzaData? // ← NUEVO: datos específicos de la libranza
  parties             ContractParty[]
  clauses             ContractClause[]
  signers             ContractSigner[]
  signatures          Signature[]
  documents           ContractDocument[]
  contractAuditEvents ContractAuditEvent[]
  isSigned Boolean @default(false)
  @@index([adminId])
  @@index([status])
}

enum ContractStatus {
  DRAFT // creado, editable por asesor
  PENDING_DOCUMENTS // falta subir documentos
  DOCUMENTS_UPLOADED // documentos completos
  PENDING_VERIFICATION // validación (opcional: manual o automática)
  READY_TO_SIGN // listo para firma
  SENT // link enviado al cliente
  VIEWED // cliente abrió link
  OTP_PENDING // esperando verificación OTP
  OTP_VERIFIED // OTP validado
  PARTIALLY_SIGNED // firma parcial
  SIGNED // contrato firmado
  REJECTED // rechazado (docs inválidos o cliente)
  EXPIRED // expirado
  CANCELLED // cancelado manualmente
}

// ─────────────────────────────────────────────────────────
// LIBRANZA — datos específicos del documento
// Relación 1-a-1 con Contract
// ─────────────────────────────────────────────────────────
model LibranzaData {
  id         String   @id @default(uuid())
  contractId String   @unique
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  // Encabezado
  ciudad String?
  asesor String?
  fecha  String? // "DD/MM/AAAA"

  // Datos personales
  clienteNombre      String?
  clienteCC          String?
  clienteCCDe        String?
  clienteDireccion   String?
  clienteTelefono    String?
  clienteEmail       String?
  clienteFuncionario String?
  clienteDesdeHace   String?

  // NUEVO
  clienteFechaNacimiento   DateTime? @db.Date
  clienteFechaExpedicionCC DateTime? @db.Date

  // Datos laborales
  municipioTrabajo String?
  empresaTrabajo   String?
  departamento     String?

  // NUEVO - pagaduría
  pagaduriaNombre       String?
  pagaduriaMunicipio    String?
  pagaduriaDepartamento String?
  tipoContrato          ContractEmploymentType?

  // Financiero
  sumaTotal    String?
  numeroCuotas String?
  valorCuota   String?
  mesCobro     String?

  // Cuenta bancaria
  tipoCuenta   String?
  numeroCuenta String?
  banco        String?

  productos Json?

  formaPago String?

  createdAt  DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @db.Timestamptz(3)
  references Reference[]

  @@index([contractId])
  @@index([pagaduriaNombre])
  @@index([tipoContrato])
}

enum ContractEmploymentType {
  PROVISIONAL
  TEMPORAL
  PROVISIONAL_VACANTE_DEFINITIVA
  CARRERA_ADMINISTRATIVA
  PENSIONADO
}

// ─────────────────────────────────────────────────────────
// Los modelos de abajo NO cambian — igual que antes
// ─────────────────────────────────────────────────────────

model ContractParty {
  id         String   @id @default(uuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  role           PartyRole
  name           String
  identification String?
  email          String?
  phone          String?
  address        String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([contractId])
  @@index([role])
}

model ContractClause {
  id         String   @id @default(uuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  position Int
  content  String @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([contractId])
}

model ContractSigner {
  id         String   @id @default(uuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  partyRole   PartyRole?
  name        String
  email       String?
  phone       String?
  roleTitle   String?
  signerOrder Int        @default(1)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  signatures          Signature[]
  contractAuditEvents ContractAuditEvent[]

  @@index([contractId])
}

model Signature {
  id         String   @id @default(uuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  signerId String?
  signer   ContractSigner? @relation(fields: [signerId], references: [id], onDelete: SetNull)


  type       SignatureType
  imageUrl   String?
  typedValue String?
  signedAt   DateTime      @default(now()) @db.Timestamptz(3)
  ipAddress  String?
  userAgent  String?

  // ── Validez legal ─────────────────────────────────────
  documentHash String?
  signerEmail  String?
  otpVerified  Boolean @default(false)

  // ── Storage de firma dibujada ────────────────────────
  signaturePublicId String?
  mimeType          String?

  @@index([contractId])
  @@index([signerId])
}


enum SignatureType {
  DRAWN
  TYPED
  CLICK_TO_SIGN
}

enum PartyRole {
  ACREEDOR
  DEUDOR
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}
// ─────────────────────────────────────────────────────────
// DOCUMENTOS ADJUNTOS — subidos por el cliente al firmar
// ─────────────────────────────────────────────────────────
model ContractDocument {
  id         String               @id @default(uuid())
  contractId String
  type       ContractDocumentType

  status DocumentStatus @default(PENDING)
  notes  String?

  fileUrl  String?
  fileName String?
  mimeType String?
  source   DocumentSource?

  publicId     String?
  resourceType String?
  format       String?
  bytes        Int?

  reviewedById String?
  reviewedAt   DateTime?

  uploadedById String?
  uploadedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  reviewedBy Admin?   @relation("ReviewedContractDocuments", fields: [reviewedById], references: [id])
  uploadedBy Admin?   @relation("UploadedContractDocuments", fields: [uploadedById], references: [id])

  @@unique([contractId, type])
  @@index([contractId])
  @@index([type])
  @@index([status])
}

enum ContractDocumentType {
  ID_FRONT
  ID_BACK
  SELFIE_WITH_ID
  BANK_CERTIFICATE
  PAYROLL_STUB
  ADDITIONAL_DOCUMENT
}

enum DocumentSource {
  CAMERA
  FILE_UPLOAD
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

model ContractAuditEvent {
  id         String  @id @default(uuid())
  contractId String
  signerId   String?
  adminId    String?

  eventType AuditEventType
  actorType AuditActorType
  actorRole AdminRole?

  actorName  String?
  actorEmail String?

  ipAddress String?
  userAgent String?
  sessionId String?
  requestId String?

  documentHash String?

  previousEventHash String?
  eventHash         String

  metadata Json?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  contract Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  signer   ContractSigner? @relation(fields: [signerId], references: [id], onDelete: SetNull)
  admin    Admin?          @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([contractId, createdAt])
  @@index([contractId, id])
  @@index([eventType])
  @@index([signerId])
  @@index([adminId])
}

enum AuditEventType {
  CONTRACT_CREATED
  CONTRACT_UPDATED
  CONTRACT_SENT

  EMAIL_SEND_REQUESTED
  EMAIL_SENT
  EMAIL_FAILED

  LINK_OPENED
  OTP_SENT
  OTP_VERIFIED

  SIGNATURE_STARTED
  SIGNATURE_COMPLETED

  ID_FRONT_UPLOADED
  ID_BACK_UPLOADED
  SELFIE_WITH_ID_UPLOADED
  BANK_CERTIFICATE_UPLOADED
  PAYROLL_STUB_UPLOADED
  ADDITIONAL_DOCUMENT_UPLOADED

  CONTRACT_SIGNED
  CONTRACT_DOWNLOADED

  CONTRACT_CANCELLED
  CONTRACT_EXPIRED
  HASH_SEALED
}

enum AuditActorType {
  ADMIN
  OPERATOR
  CREDIT_ANALYST
  SIGNER
  SYSTEM
}

model Reference {
  id         String       @id @default(uuid())
  libranzaId String
  libranza   LibranzaData @relation(fields: [libranzaId], references: [id], onDelete: Cascade)

  type         ReferenceType
  name         String
  phone        String?
  email        String?
  company      String?
  position     String?
  relationShip String?
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)

  @@index([libranzaId])
}

enum ReferenceType {
  PERSONAL
  LABORAL
}


model PublicContractSession {
  id             String    @id @default(uuid())
  email           String

  otpCode         String?
  otpExpiresAt    DateTime?
  otpAttempts     Int       @default(0)

  sessionToken    String?   @unique
  expiresAt       DateTime?
  verifiedAt      DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt


  @@index([email])
  @@index([sessionToken])
  @@unique([email])
}